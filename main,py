        self.two_player_btn.background_color = (1, 1, 1, 1)
        self.player2_label.opacity = 0
        self.player2_input.opacity = 0
        self.player2_input.disabled = True

    def select_two_player_mode(self, instance):
        """Enable local two-player mode and reveal the Player 2 input field."""
        self.is_ai_mode = False
        self.two_player_btn.background_color = (0.2, 0.8, 0.2, 1)
        self.ai_btn.background_color = (1, 1, 1, 1)
        self.player2_label.opacity = 1
        self.player2_input.opacity = 1
        self.player2_input.disabled = False

    def start_game(self, instance):
        """Validate setup form inputs and transition to the active GameScreen."""
        regex = r'^[a-zA-Z0-9_ ]+$'
        name1 = self.player1_input.text.strip()
        name2 = self.player2_input.text.strip()
        if not name1 or not re.match(regex, name1):
            self.show_error("Please enter a valid Player 1 name (letters, numbers, spaces, underscores)")
            return
        if not self.is_ai_mode and (not name2 or not re.match(regex, name2)):
            self.show_error("Please enter a valid Player 2 name (letters, numbers, spaces, underscores)")
            return
        try:
            time_control = int(self.time_input.text)
            increment = int(self.increment_input.text)
            if time_control <= 0 or increment < 0:
                raise ValueError
        except ValueError:
            self.show_error("Please enter valid positive numbers for time control and increment")
            return

        self.white_name = name1
        self.black_name = 'AI' if self.is_ai_mode else name2
        game_screen = self.manager.get_screen('game')
        game_screen.initialise_game(
            self.white_name,
            self.black_name,
            self.is_ai_mode,
            time_control,
            increment
        )
        self.manager.current = 'game'

    def show_error(self, message):
        """Display a modal error popup with the given message."""
        popup = Popup(title='Error', content=Label(text=message), size_hint=(0.6, 0.3))
        popup.open()


class GameScreen(Screen):
