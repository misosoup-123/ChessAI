    def create_board(self):
        """Populate the 8x8 GridLayout with alternating light and dark square buttons."""
        for row in range(8):
            for col in range(8):
                is_light = (row + col) % 2 == 0
                color = (0.95, 0.95, 0.85, 1) if is_light else (0.8, 0.4, 0.2, 1)
                btn = Button(background_color=color, font_size=40, bold=True)
                btn.row = row
                btn.col = col
                btn.original_color = color
                btn.bind(on_press=self.on_square_press)
                self.board_buttons[(row, col)] = btn
                self.board_layout.add_widget(btn)

    def initialise_game(self, player1_name, player2_name, is_ai, time_control, increment):
        """Reset timers, events, and ChessGame model for a newly started match."""
        if self.timer_event:
            self.timer_event.cancel()
        if self.ai_event:
            self.ai_event.cancel()
            self.ai_event = None
        if self.promotion_popup:
            self.promotion_popup.dismiss()
            self.promotion_popup = None

        self.ai_thinking = False
        self.awaiting_promotion = False
        self.game = ChessGame(game_screen=self)
        self.selected_square = None
        self.white_time = time_control * 60
        self.black_time = time_control * 60
        self.increment = increment
        self.is_ai = is_ai
        self.player1_label.text = f'{player1_name} (White)'
        self.player2_label.text = f'{player2_name} (Black)'
        self.player1_name = player1_name
        self.player2_name = player2_name
        self.initial_time_control_minutes = time_control
        self.move_list.clear_widgets()
        self.status_label.color = (0, 0.8, 0, 1)
        self.update_timer_display()
        self.timer_event = Clock.schedule_interval(self.update_timer, 1.0)
        self.status_label.text = 'Game started!'
        self.saved_game_record = False
        self.update_board_display()
        self.update_turn_indicator()

    def show_promotion_popup(self, row, col):
        """Open a non-dismissible modal prompting the player to pick a promotion piece."""
        self.awaiting_promotion = True
        content = BoxLayout(orientation='vertical', spacing=10, padding=10)
        content.add_widget(Label(text='Promote to:', font_size=18))
        pieces_layout = BoxLayout(orientation='horizontal', spacing=10)
        for piece in ['queen', 'rook', 'bishop', 'knight']:
            btn = Button(text=piece.capitalize(), font_size=16)
            btn.bind(on_press=lambda instance, p=piece: self.handle_promotion(row, col, p))
            pieces_layout.add_widget(btn)
        content.add_widget(pieces_layout)
        self.promotion_popup = Popup(title='Pawn Promotion', content=content,
                                     size_hint=(0.6, 0.4), auto_dismiss=False)
        self.promotion_popup.open()

    def handle_promotion(self, row, col, piece_type):
        """Apply chosen promotion piece, refresh UI, and trigger AI reply if applicable."""
        self.promotion_popup.dismiss()
        self.promotion_popup = None
        self.awaiting_promotion = False
        self.game.promotion(row, col, piece_type)
        self.update_board_display()
        self.update_move_history()
        self.update_turn_indicator()
        self.maybe_start_ai()

    def update_board_display(self):
        """Sync board button textures (or fallback letters) with the current board array."""
        for row in range(8):
            for col in range(8):
                btn = self.board_buttons[(row, col)]
                piece = self.game.get_piece_at(row, col)
                if piece:
                    piece_image_path = os.path.join(IMAGE_DIR, f"{piece['colour']}-{piece['piece']}.png")
                    if os.path.exists(piece_image_path):
                        btn.text = ''
                        btn.background_normal = piece_image_path
                    else:
                        btn.text = self.FALLBACK_LETTERS[piece['piece']]
                        btn.color = (1, 1, 1, 1) if piece['colour'] == 'white' else (0, 0, 0, 1)
                        btn.background_normal = ''
                else:
                    btn.text = ''
                    btn.background_normal = ''
                btn.background_color = btn.original_color

    def select_square(self, row, col):
        """Highlight (row, col) yellow and store it as the active piece selection."""
        self.selected_square = (row, col)
        self.board_buttons[(row, col)].background_color = (1, 1, 0, 1)

    def on_square_press(self, instance):
        """Handle square clicks for piece selection, re-selection, and move execution."""
        if not self.game or self.game.game_over or self.awaiting_promotion or self.ai_thinking:
            return
        if self.is_ai and self.game.current_player == 'black':
            return

        row, col = instance.row, instance.col
        clicked = self.game.get_piece_at(row, col)

        if self.selected_square is None:
            if clicked and clicked['colour'] == self.game.current_player:
                self.select_square(row, col)
            return

        from_row, from_col = self.selected_square
        if (row, col) == self.selected_square:
            self.clear_selection()
            return

        if self.game.make_move(from_row, from_col, row, col):
            self.clear_selection()
            # Award Fischer time increment to the side that just completed its move
            if self.game.current_player == 'black':
                self.white_time += self.increment
            else:
                self.black_time += self.increment
            self.update_board_display()
            self.update_move_history()
            self.update_turn_indicator()
            self.check_game_over()
            self.maybe_start_ai()
        elif clicked and clicked['colour'] == self.game.current_player:
            self.clear_selection()
            self.select_square(row, col)
        else:
            self.clear_selection()

    def maybe_start_ai(self):
        """Schedule the AI turn on the next frame if it is Black's turn in AI mode."""
        if (self.is_ai and self.game and not self.game.game_over
                and self.game.current_player == 'black' and not self.awaiting_promotion):
            self.ai_thinking = True
            self.status_label.text = 'AI is thinking...'
            self.ai_event = Clock.schedule_once(self.ai_turn, 0.05)

    def ai_turn(self, dt):
        """Run Minimax search on a background thread to keep the Kivy UI responsive."""
        self.ai_event = None
        if not self.game or self.game.game_over or self.game.current_player != 'black':
            self.ai_thinking = False
            return

        def worker():
            moved = self.game.ai_move(depth=4)
            # Marshal UI updates back onto Kivy's main thread
            Clock.schedule_once(lambda _dt: self._finish_ai_turn(moved), 0)

        threading.Thread(target=worker, daemon=True).start()

    def _finish_ai_turn(self, moved):
        """Apply AI move increments, refresh board widgets, and unlock user input."""
        try:
            if not self.game:
                return
            if moved:
                self.black_time += self.increment
            self.update_board_display()
            self.update_move_history()
            self.update_turn_indicator()
            self.update_timer_display()
            if not self.game.game_over:
                self.status_label.text = 'Game in progress'
            self.check_game_over()
        finally:
            self.ai_thinking = False

    def clear_selection(self):
        """Reset the highlighted square colour and clear selection state."""
        if self.selected_square:
            row, col = self.selected_square
            btn = self.board_buttons[(row, col)]
            btn.background_color = btn.original_color
        self.selected_square = None

    def update_move_history(self):
        """Rebuild the scrollable move list with one Label per full move pair."""
        moves = self.game.move_history
        self.move_list.clear_widgets()
        for i in range(0, len(moves), 2):
            text = f"{i // 2 + 1}. {moves[i]}"
            if i + 1 < len(moves):
                text += f"   {moves[i + 1]}"
            row = Label(
                text=text,
                font_size=16,
                size_hint_y=None,
                height=24,
                size_hint_x=1,
                halign='left',
                valign='middle',
            )
            # Constrain text bounding box to row width for left alignment and clipping
            row.bind(width=lambda inst, w: setattr(inst, 'text_size', (max(w - 10, 10), inst.height)))
            self.move_list.add_widget(row)
        Clock.schedule_once(lambda dt: setattr(self.move_scroll, 'scroll_y', 0), 0.05)

    def update_turn_indicator(self):
        """Update the status label showing active side, check warning, or winner."""
        if self.game.game_over:
            if self.game.winner == 'draw':
                self.turn_indicator.text = "Draw!"
                self.turn_indicator.color = (1, 1, 0, 1)
            else:
                winner = self.game.winner.capitalize()
                self.turn_indicator.text = f"{winner} Wins!"
                self.turn_indicator.color = (0, 1, 0, 1)
        else:
            current = self.game.current_player.capitalize()
            self.turn_indicator.text = f"{current}'s Turn"
            if self.game.in_check:
                self.turn_indicator.text += " (Check!)"
                self.turn_indicator.color = (1, 0, 0, 1)
            else:
                self.turn_indicator.color = (0, 1, 0, 1)

    def update_timer(self, dt):
        """Tick the active player's clock down by 1 second and flag timeouts."""
        if self.game and not self.game.game_over:
            if self.game.current_player == 'white':
                self.white_time -= 1
                if self.white_time <= 0:
                    self.white_time = 0
                    self.game.game_over = True
                    self.game.winner = 'black'
                    self.game.end_reason = 'timeout'
            else:
                self.black_time -= 1
                if self.black_time <= 0:
                    self.black_time = 0
                    self.game.game_over = True
                    self.game.winner = 'white'
                    self.game.end_reason = 'timeout'
            self.update_timer_display()
            if self.game.game_over:
                self.update_turn_indicator()
                self.check_game_over()

    def update_timer_display(self):
        """Format remaining clock seconds as M:SS with colour-coded urgency thresholds."""
        def format_time(seconds):
            return f"{seconds // 60}:{seconds % 60:02d}"

        self.player1_timer.text = format_time(self.white_time)
        self.player2_timer.text = format_time(self.black_time)
        self.player1_timer.color = (1, 0, 0, 1) if self.white_time < 60 else ((1, 1, 0, 1) if self.white_time < 300 else (0, 1, 0, 1))
        self.player2_timer.color = (1, 0, 0, 1) if self.black_time < 60 else ((1, 1, 0, 1) if self.black_time < 300 else (0, 1, 0, 1))

    def check_game_over(self):
        """Halt clocks, display the outcome message, and log the match to CSV once."""
        if self.game.game_over:
            if self.timer_event:
                self.timer_event.cancel()
            reason = self.game.end_reason
            if self.game.winner == 'draw':
                self.status_label.text = 'Game drawn by stalemate!'
            elif self.game.winner:
                winner = self.game.winner.capitalize()
                loser = 'White' if winner == 'Black' else 'Black'
                if reason == 'checkmate':
                    self.status_label.text = f'Checkmate! {winner} wins!'
                elif reason == 'timeout':
                    self.status_label.text = f'{loser} ran out of time! {winner} wins!'
                elif reason == 'resignation':
                    self.status_label.text = f'{loser} resigned! {winner} wins!'
                else:
                    self.status_label.text = f'{winner} wins!'
            self.status_label.color = (1, 1, 0, 1)
            if not self.saved_game_record:
                self.saved_game_record = True
                try:
                    self.save_game_record()
                except Exception as e:
                    self.show_error(f"Error saving game record: {e}")

    def show_error(self, message):
        """Display a modal error popup on the game screen."""
        popup = Popup(title='Error', content=Label(text=message), size_hint=(0.6, 0.3))
        popup.open()

    def resign_game(self, instance):
        """Forfeit the match on behalf of the active player."""
        if self.game and not self.game.game_over and not self.ai_thinking:
            current = self.game.current_player
            self.game.game_over = True
            self.game.winner = 'black' if current == 'white' else 'white'
            self.game.end_reason = 'resignation'
            self.update_turn_indicator()
            self.check_game_over()

    def save_game_record(self):
        """Append completed match metadata and move history to chessgame.csv."""
        csv_path = os.path.join(BASE_DIR, 'chessgame.csv')
        header = [
            'timestamp_utc', 'white_player', 'black_player',
            'start_time_minutes', 'increment_seconds', 'is_ai',
            'result', 'moves', 'white_time_remaining_seconds',
            'black_time_remaining_seconds', 'total_moves'
        ]
        timestamp = datetime.now(timezone.utc).isoformat()
        if self.game.winner == 'draw':
            result = 'draw'
        elif self.game.winner:
            winner_name = self.player1_name if self.game.winner == 'white' else self.player2_name
            result = f"{winner_name} ({self.game.winner})"
        else:
            result = 'unknown'

        row = [
            timestamp, self.player1_name, self.player2_name,
            str(self.initial_time_control_minutes), str(self.increment),
            str(bool(self.is_ai)), result, ' | '.join(self.game.move_history),
            str(int(self.white_time)), str(int(self.black_time)),
            str(len(self.game.move_history))
        ]
        write_header = not os.path.exists(csv_path) or os.path.getsize(csv_path) == 0
        with open(csv_path, 'a', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            if write_header:
                writer.writerow(header)
            writer.writerow(row)

    def new_game(self, instance):
        """Cancel active clocks/events and return to the setup screen."""
        if self.timer_event:
            self.timer_event.cancel()
        if self.ai_event:
            self.ai_event.cancel()
            self.ai_event = None
        self.ai_thinking = False
        if self.promotion_popup:
            self.promotion_popup.dismiss()
            self.promotion_popup = None
        self.awaiting_promotion = False
        self.manager.current = 'home'

    def quit_game(self, instance):
        """Terminate the Kivy application."""
        App.get_running_app().stop()


class ChessApp(App):
    """Root Kivy application managing screen navigation."""

    def build(self):
        """Instantiate and register the HomeScreen and GameScreen."""
        self.title = 'Chess Game'
        Window.clearcolor = (0.1, 0.1, 0.1, 1)
        sm = ScreenManager()
        sm.add_widget(HomeScreen(name='home'))
        sm.add_widget(GameScreen(name='game'))
        return sm


def main():
    """Application entry point."""
    ChessApp().run()


if __name__ == '__main__':
    main()